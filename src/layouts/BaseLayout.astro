---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const { title, description = '', ogType = 'website', ogImage } = Astro.props;
const siteUrl = 'https://postcart.app';
const canonical = `${siteUrl}${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang="fr-FR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com/" />
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/favicon.png" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <style is:inline>.pc-cta-block{border-radius:.875rem;padding:1.75rem 2rem;margin:2.5rem 0}.pc-cta-block--sim{background:#f0f9ff;border:1px solid #bae6fd}.pc-cta-block--app{background:#fff7ed;border:1px solid #fed7aa}.pc-cta-block--final{background:linear-gradient(135deg,#1e3a5f 0%,#2b6cb0 100%)}.pc-cta-block__eyebrow{font-size:.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.625rem}.pc-cta-block--sim .pc-cta-block__eyebrow{color:#0369a1}.pc-cta-block--app .pc-cta-block__eyebrow{color:#c2410c}.pc-cta-block--final .pc-cta-block__eyebrow{color:rgba(255,255,255,.65)}.pc-cta-block__title{font-size:1.125rem;font-weight:700;line-height:1.35;margin:0 0 .5rem}.pc-cta-block--sim .pc-cta-block__title{color:#0c2d4a}.pc-cta-block--app .pc-cta-block__title{color:#7c2d12}.pc-cta-block--final .pc-cta-block__title{color:#fff;font-size:1.25rem}.pc-cta-block__sub{font-size:.875rem;line-height:1.6;margin-bottom:1.25rem}.pc-cta-block--sim .pc-cta-block__sub,.pc-cta-block--app .pc-cta-block__sub{color:#374151}.pc-cta-block--final .pc-cta-block__sub{color:rgba(255,255,255,.85)}.pc-cta-btn{display:inline-flex;align-items:center;gap:.375rem;font-size:.9375rem;font-weight:600;padding:.6875rem 1.5rem;border-radius:.5rem;text-decoration:none!important;transition:all .18s}.pc-cta-btn--blue{background:#2b6cb0;color:#fff!important}.pc-cta-btn--blue:hover{background:#1d4f8e;box-shadow:0 4px 12px rgba(43,108,176,.35);transform:translateY(-1px)}.pc-cta-btn--orange{background:#e8660a;color:#fff!important}.pc-cta-btn--orange:hover{background:#d45f00;box-shadow:0 4px 12px rgba(232,102,10,.35);transform:translateY(-1px)}.pc-cta-btn--white{background:#fff;color:#1e3a5f!important;font-weight:700}.pc-cta-btn--white:hover{background:#f0f9ff;box-shadow:0 4px 12px rgba(0,0,0,.12);transform:translateY(-1px)}.pc-cta-trust{display:flex;flex-wrap:wrap;gap:.625rem 1.25rem;margin-top:1rem;font-size:.8125rem;font-weight:500}.pc-cta-trust-item::before{content:"✓";margin-right:.3rem}.pc-cta-block--sim .pc-cta-trust,.pc-cta-block--app .pc-cta-trust{color:#4b5563}.pc-cta-block--sim .pc-cta-trust-item::before,.pc-cta-block--app .pc-cta-trust-item::before{color:#22c55e}.pc-cta-block--final .pc-cta-trust{color:rgba(255,255,255,.8)}.pc-cta-block--final .pc-cta-trust-item::before{color:#86efac}</style>
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="PostCart" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
</head>
<body>
  <div class="pc-rails" aria-hidden="true"></div>

  <nav class="pc-nav">
    <div class="pc-nav-inner">
      <a href="https://postcart.app/" class="pc-logo">
        <img src="https://postcart.app/wp-content/themes/postcart-v2/assets/logo.png" alt="PostCart.app" height="80" />
      </a>
      <div class="pc-nav-links">
        <a href="https://postcart.app/">Accueil</a>
        <a href="https://postcart.app/#solution">Solution</a>
        <a href="https://postcart.app/#fonctionnement">Comment ça marche ?</a>
        <a href="/blog/">Blog</a>
      </div>
      <a href="https://postcart.app/#install" class="pc-nav-cta">
        Installer sur Shopify
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </a>
    </div>
    <div class="pc-dotted-sep" aria-hidden="true"></div>
  </nav>

  <slot />

  <div class="pc-dotted-sep" aria-hidden="true"></div>

  <footer class="pc-footer">
    <div class="pc-container">
      <div class="pc-footer-links">
        <a href="https://postcart.app/#solution">Solution</a>
        <a href="https://postcart.app/#fonctionnement">Comment ça marche ?</a>
        <a href="https://postcart.app/#pour-qui">Pour qui ?</a>
        <a href="https://postcart.app/#rgpd">RGPD</a>
        <a href="/blog/">Blog</a>
      </div>
      <p>© 2026 PostCart.app. Tous droits réservés.</p>
    </div>
  </footer>
</body>
</html>
