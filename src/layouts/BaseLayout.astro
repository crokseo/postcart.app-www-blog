---
interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
}

const { title, description = "", ogType = "website", ogImage } = Astro.props;
const siteUrl = "https://www.postcart.app";
const canonical = `${siteUrl}${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang="fr-FR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com/" />
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/favicon.png" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="PostCart" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <style>
    .pc-nav { background: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .pc-logo img { mix-blend-mode: multiply; }
  </style>
</head>
<body>
  <div class="pc-rails" aria-hidden="true"></div>

  <nav class="pc-nav">
    <div class="pc-nav-inner">
      <a href="https://www.postcart.app/" class="pc-logo">
        <img src="https://postcart.app/wp-content/themes/postcart-v2/assets/logo.png" alt="PostCart.app" height="80" />
      </a>
      <div class="pc-nav-links">
        <a href="https://www.postcart.app/">Accueil</a>
        <a href="https://www.postcart.app/#solution">Solution</a>
        <a href="https://www.postcart.app/#fonctionnement">Comment ça marche ?</a>
        <a href="/blog/">Blog</a>
      </div>
      <a href="https://www.postcart.app/#install" class="pc-nav-cta">
        Installer sur Shopify
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </a>
    </div>
    <div class="pc-dotted-sep" aria-hidden="true"></div>
  </nav>

  <slot />

  <div class="pc-dotted-sep" aria-hidden="true"></div>

  <footer class="pc-footer">
    <div class="pc-container">
      <div class="pc-footer-links">
        <a href="https://www.postcart.app/#solution">Solution</a>
        <a href="https://www.postcart.app/#fonctionnement">Comment ça marche ?</a>
        <a href="https://www.postcart.app/#pour-qui">Pour qui ?</a>
        <a href="https://www.postcart.app/#rgpd">RGPD</a>
        <a href="/blog/">Blog</a>
      </div>
      <p>© 2026 PostCart.app. Tous droits réservés.</p>
    </div>
  </footer>
</body>
</html>
