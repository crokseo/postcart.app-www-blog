---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  category?: string;
  categorySlug?: string;
  date?: string;
  readingTime?: string;
  image?: string;
  imageAlign?: 'left' | 'center' | 'right';
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const {
  title,
  description,
  category,
  categorySlug,
  date,
  readingTime,
  image,
  imageAlign = 'center',
  prev,
  next,
} = Astro.props;

// ── Logique de sélection des CTAs outils ──────────────────────────────────

// Durée de lecture → article long si ≥ 6 min
const readingMinutes = readingTime ? parseInt(readingTime) : 5;
const isLongArticle = readingMinutes >= 6;

// Pool complet des CTAs outils disponibles
const toolPool = [
  {
    id: 'simulator-loss',
    categories: ['donnees-benchmarks', 'comprendre-le-probleme', 'strategie'],
    eyebrow: 'Outil gratuit',
    title: 'Calculez combien vous coûtent vos paniers abandonnés chaque mois.',
    sub: 'Entrez votre CA mensuel et votre taux d\'abandon : le simulateur calcule en 30 secondes votre manque à gagner réel.',
    href: '/simulateur/',
    btnLabel: 'Calculer mon manque à gagner →',
    btnClass: 'pc-cta-btn--blue',
    blockClass: 'pc-cta-block--sim',
    trust: ['Gratuit', 'Sans inscription', 'Résultat immédiat'],
  },
  {
    id: 'simulator-roi',
    categories: ['canaux-de-relance', 'strategie', 'preuves-roi'],
    eyebrow: 'Simulateur ROI',
    title: 'Estimez le retour sur investissement d\'une campagne carte postale PostCart.',
    sub: 'Panier moyen, volume d\'abandons, taux de récupération estimé : obtenez 3 scénarios chiffrés pour votre boutique.',
    href: '/simulateur/',
    btnLabel: 'Simuler mon ROI →',
    btnClass: 'pc-cta-btn--blue',
    blockClass: 'pc-cta-block--sim',
    trust: ['Calcul personnalisé', 'Sans inscription', '3 scénarios ROI'],
  },
  {
    id: 'quiz',
    categories: ['strategie', 'canaux-de-relance', 'comprendre-le-probleme'],
    eyebrow: 'Quiz — 2 minutes',
    title: 'Quel type de relanceur de panier êtes-vous ?',
    sub: '6 questions pour identifier votre profil et recevoir une recommandation de canal de relance adaptée à votre boutique.',
    href: '/outils/quiz-quel-type-de-relanceur/',
    btnLabel: 'Faire le quiz →',
    btnClass: 'pc-cta-btn--blue',
    blockClass: 'pc-cta-block--sim',
    trust: ['Résultat immédiat', 'Sans inscription', 'Recommandation personnalisée'],
    comingSoon: true, // Remplacer par false quand la page est en ligne
  },
  {
    id: 'guide',
    categories: ['comprendre-le-probleme', 'donnees-benchmarks'],
    eyebrow: 'Guide complet',
    title: 'Maîtrisez la relance de panier abandonné de A à Z.',
    sub: 'Causes, canaux, séquences, RGPD : tout ce qu\'il faut savoir pour récupérer vos paniers avec un taux d\'ouverture à 91 %.',
    href: '/blog/relance-panier-abandonne-guide-complet/',
    btnLabel: 'Lire le guide →',
    btnClass: 'pc-cta-btn--blue',
    blockClass: 'pc-cta-block--sim',
    trust: ['Lecture : 12 min', 'Cas pratiques inclus', 'Mis à jour 2026'],
    comingSoon: true,
  },
];

// Filtrer les CTAs disponibles (exclure comingSoon)
const availableTools = toolPool.filter(c => !c.comingSoon);

// Sélectionner les CTAs selon la catégorie, sans doublons
function selectTools(slug: string | undefined, count: number) {
  // Priorité : CTAs dont la catégorie correspond à l'article
  const matching = availableTools.filter(c => c.categories.includes(slug ?? ''));
  const others = availableTools.filter(c => !c.categories.includes(slug ?? ''));
  const ordered = [...matching, ...others];

  // Dédupliquer et prendre `count` CTAs
  const seen = new Set<string>();
  const result = [];
  for (const cta of ordered) {
    if (!seen.has(cta.id)) {
      seen.add(cta.id);
      result.push(cta);
      if (result.length >= count) break;
    }
  }
  return result;
}

const toolCount = isLongArticle ? 2 : 1;
const selectedTools = selectTools(categorySlug, toolCount);

// CTA final app (toujours présent, toujours en dernier)
const ctaFinal = {
  title: 'Récupérez vos paniers abandonnés avec un canal à 91 % d\'ouverture.',
  sub: 'Envoyez vos 15 premières cartes postales gratuitement. Sans engagement, sans carte bancaire.',
  href: 'https://www.postcart.app/#install',
  btnLabel: 'Accéder à l\'application →',
  trust: ['Sans engagement', 'Support français', 'ROI mesurable dès la première campagne'],
};
---
<BaseLayout title={`${title} - PostCart`} description={description} ogType="article" ogImage={image}>
  <div class="pc-container">
    <div class="pc-single-header">
      <div class="pc-single-meta">
        {category && categorySlug && (
          <>
            <a href={`/category/${categorySlug}/`}>{category}</a>
            <span>·</span>
          </>
        )}
        {date && <span>{date}</span>}
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime}</span>
          </>
        )}
      </div>
      <h1>{title}</h1>
    </div>
  </div>

  {image && (
    <div class="pc-container">
      <div class={`pc-single-hero-img${imageAlign !== 'center' ? ` pc-single-hero-img--${imageAlign}` : ''}`}>
        <img src={image} alt={title} />
      </div>
    </div>
  )}

  <div class="pc-dotted-sep" aria-hidden="true"></div>

  <div class="pc-container">
    <div class="pc-article-content">
      <slot />

      {selectedTools.map(cta => (
        <div class={`pc-cta-block ${cta.blockClass}`}>
          <div class="pc-cta-block__eyebrow">{cta.eyebrow}</div>
          <p class="pc-cta-block__title">{cta.title}</p>
          <p class="pc-cta-block__sub">{cta.sub}</p>
          <a href={cta.href} class={`pc-cta-btn ${cta.btnClass}`}>{cta.btnLabel}</a>
          <div class="pc-cta-trust">
            {cta.trust.map(item => <span class="pc-cta-trust-item">{item}</span>)}
          </div>
        </div>
      ))}

      <div class="pc-cta-block pc-cta-block--final">
        <p class="pc-cta-block__title">{ctaFinal.title}</p>
        <p class="pc-cta-block__sub">{ctaFinal.sub}</p>
        <a href={ctaFinal.href} class="pc-cta-btn pc-cta-btn--orange">{ctaFinal.btnLabel}</a>
        <div class="pc-cta-trust">
          {ctaFinal.trust.map(item => <span class="pc-cta-trust-item">{item}</span>)}
        </div>
      </div>
    </div>
  </div>

  <div class="pc-dotted-sep" aria-hidden="true"></div>

  <div class="pc-container">
    <div class="pc-author-block">
      <img
        src="https://www.crokseo.com/wp-content/uploads/2025/12/Eric-Kolmerschlag.jpg.webp"
        alt="Éric Kolmerschlag"
        class="pc-author-avatar"
        width="80"
        height="80"
      />
      <div class="pc-author-info">
        <div class="pc-author-name">Éric Kolmerschlag</div>
        <div class="pc-author-title">Consultant senior en webmarketing</div>
        <p class="pc-author-bio">
          Éric accompagne les e-commerçants depuis plus de 15 ans sur leurs stratégies d'acquisition et de conversion.
          Il partage ses analyses et méthodes sur <a href="https://www.crokseo.com" target="_blank" rel="noopener">Crokseo.com</a>,
          sa <span class="pc-author-link-js" role="link" tabindex="0" data-url="https://www.youtube.com/@crokseo">chaîne YouTube</span>
          et <span class="pc-author-link-js" role="link" tabindex="0" data-url="https://www.linkedin.com/in/eric-kolmerschlag-3a2903135/">LinkedIn</span>,
          et est associé de la marque <a href="https://ascenbio-thes.com/" target="_blank" rel="noopener">Ascenbio Thé</a>.
        </p>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.pc-author-link-js').forEach(el => {
      el.addEventListener('click', () => window.open((el as HTMLElement).dataset.url, '_blank'));
      el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') window.open((el as HTMLElement).dataset.url, '_blank'); });
    });
  </script>

  {(prev || next) && (
    <>
      <div class="pc-dotted-sep" aria-hidden="true"></div>
      <div class="pc-container">
        <div class="pc-post-nav">
          {prev ? (
            <a href={`/blog/${prev.slug}/`} class="pc-post-nav-item">
              <div class="pc-post-nav-label">← Précédent</div>
              <div class="pc-post-nav-title">{prev.title}</div>
            </a>
          ) : <div />}
          {next ? (
            <a href={`/blog/${next.slug}/`} class="pc-post-nav-item pc-post-nav-item--next">
              <div class="pc-post-nav-label">Suivant →</div>
              <div class="pc-post-nav-title">{next.title}</div>
            </a>
          ) : <div />}
        </div>
      </div>
    </>
  )}
</BaseLayout>
